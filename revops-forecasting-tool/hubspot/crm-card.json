    "objectTypes": [
      {
        "name": "deals",
        "propertiesToSend": ["hs_pipeline", "hubspot_owner_id"]
      },
      {
        "name": "contacts",
        "propertiesToSend": []
      },
      {
        "name": "companies",
        "propertiesToSend": []
      }
    ]
  },
  "display": {
    "properties": [
      {
        "name": "forecastedRevenue",
