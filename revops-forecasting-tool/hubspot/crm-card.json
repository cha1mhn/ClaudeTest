        "dataType": "PERCENT"
      }
    ]
  },
  "actions": [
    {
      "type": "IFRAME",
      "width": 890,
      "height": 580,
      "uri": "https://YOUR_FRONTEND_URL/?view=card",
      "label": "Open Full Forecast Dashboard"
    }
  ]
