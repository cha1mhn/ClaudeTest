# HubSpot Configuration
HUBSPOT_ACCESS_TOKEN=your_private_app_token_here

# Clay Configuration
CLAY_API_KEY=your_clay_api_key_here
CLAY_TABLE_ID=your_clay_table_id_here

# Server Configuration
PORT=3002
NODE_ENV=development

# Cache TTL (seconds)
CACHE_TTL=300

# Audit Configuration
STALE_DEAL_DAYS=30
NO_ACTIVITY_DAYS=14
MISSING_AMOUNT_THRESHOLD=0
ENRICHMENT_SCORE_MIN=60

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://app.hubspot.com

# Scheduled audit (cron expression — default: daily at 7 AM)
AUDIT_CRON=0 7 * * *
